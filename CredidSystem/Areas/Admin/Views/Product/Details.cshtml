    <div class="card mb-3" style="max-width: 540px;">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="..." class="img-fluid rounded-start" alt="...">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">@Model.Name</h5>
                    <p class="card-text">@Model.Description</p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Id: @Model.Id</li>
                    <li class="list-group-item">@Model.Quantity</li>
                    <li class="list-group-item">@Model.Price$</li>
                    <li class="list-group-item">
                        Branch:
                        @foreach (var item in ViewBag.Branches)
                        {
                            if (item.Id == Model.BranchId)
                            {
                                @item.Name
                            }
                        }
                    </li>
                    <li class="list-group-item">
                        Category:
                        @foreach (var item in ViewBag.Categories)
                        {
                            if (item.Id == Model.CategoryId)
                            {
                                @item.Name
                            }
                        }
                    </li>
                </ul>
                <div class="card-body">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning me-2">Update</a>
                    <a asp-action="Index" class="btn btn-outline-primary">Back to List</a>
                </div>
            </div>
        </div>


    </div>
